# Local development defaults only. Never use these values in production.
POSTGRES_DB=yalla_dev
POSTGRES_USER=yalla
POSTGRES_PASSWORD=yalla_dev_only
POSTGRES_PORT=18081

DATABASE_HOST=localhost
DATABASE_PORT=18081
DATABASE_NAME=yalla_dev
DATABASE_USER=yalla
DATABASE_PASSWORD=yalla_dev_only

API_PORT=3000
ADMIN_WEB_ORIGIN=http://localhost:3001
CLIENT_WEB_ORIGIN=http://localhost:3002

# Optional routing server. For local OSRM in Docker, set this to http://osrm:5000.
ROUTING_BASE_URL=

# Optional reverse-geocoding server; for local tests, Nominatim may be used sparingly.
PLACE_NAME_BASE_URL=

# Provisional fare values in XAF, to be validated locally before launch.
FARE_BASE_XAF=1000
FARE_PRICE_PER_KILOMETER_XAF=350
FARE_PRICE_PER_MINUTE_XAF=10

# Mail server used for account confirmation links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Change this secret before deployment. Development default is not production-safe.
AUTH_TOKEN_SECRET=local-only-change-this-secret-before-production
