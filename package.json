{
  "name": "yalla",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin-web",
    "apps/client-web"
  ],
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  },
  "scripts": {
    "api:dev": "npm run start:dev --workspace=@yalla/api",
    "api:build": "npm run build --workspace=@yalla/api",
    "api:test": "npm run test --workspace=@yalla/api",
    "web:dev": "npm run dev --workspace=@yalla/admin-web",
    "web:build": "npm run build --workspace=@yalla/admin-web",
    "client-web:dev": "npm run dev --workspace=@yalla/client-web",
    "client-web:build": "npm run build --workspace=@yalla/client-web"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
